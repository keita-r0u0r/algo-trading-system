# 秘密情報（APIキーなど）の置き場所。docs/secrets.md を参照
#   GCP_PROJECT を設定すると、GCP Secret Manager から読む（推奨）。その場合、下の APIキーは使われない
#   設定しなければ、この .env から読む（手元の開発用）
# GCP_PROJECT=
# SECRETS_BACKEND=gcp

# J-Quants API キー
#   https://jpx-jquants.com/ のダッシュボード [API Keys] で発行する
#   V2 でトークン方式（refresh token / id token）は廃止された
JQUANTS_API_KEY=

# プラン。レート制限の間隔を決める（free=5回/分, light=60, standard=120, premium=500）
#   実際のプランより速い値を入れると 429 を踏み続けるので、必ず合わせる
JQUANTS_PLAN=free

# GMOコイン 外国為替FX（.env から読む場合のみ）
GMO_FX_API_KEY=
GMO_FX_API_SECRET=

# 拡張パーツ（カンマ区切り）。例: ai。未設定なら本体だけで動く（docs/extensions.md）
# JQBT_EXTENSIONS=ai
# AI の費用の月の上限（米ドル）。上限に達したら AI を呼ばない
# AI_MONTHLY_BUDGET_USD=5
# AI の既定のモデル（画面で保存した設定より優先する）。例: claude-opus-5-5 / claude-sonnet-5-5 / claude-haiku-5-5
# AI_MODEL=
# Anthropic の APIキー（.env から読む場合のみ。推奨は GCP Secret Manager の anthropic-api-key）
ANTHROPIC_API_KEY=
